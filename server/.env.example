# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# MongoDB Atlas (or any replica set). Transactions REQUIRE a replica set.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/buildflow?retryWrites=true&w=majority
# Set to false ONLY for local experiments on a standalone mongod. Must be true in production.
DB_REQUIRE_REPLICA_SET=true

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Business defaults
APP_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY_CALLING_CODE=91

# --- Authentication ---
# Long random value (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Refresh cookie is httpOnly always, Secure in production. lax|strict|none
REFRESH_REUSE_GRACE_SECONDS=10
COOKIE_SAMESITE=lax
BCRYPT_COST=12
# Max phone-identity checks (lookup / create / link / client create) per user+IP per window.
IDENTITY_RATE_LIMIT_MAX=30
IDENTITY_RATE_LIMIT_WINDOW_SECONDS=60
EXPORT_MAX_ROWS=20000
FOLLOWUP_MISSED_GRACE_MINUTES=30
FOLLOWUP_REMINDER_MINUTES=30
SITEVISIT_REMINDER_MINUTES=60
# Follow-up type (a FOLLOWUP_TYPE master code) and local hour for the follow-up created the day after a site visit is completed.
POST_VISIT_FOLLOWUP_TYPE_CODE=CALL
POST_VISIT_FOLLOWUP_HOUR=10
# Unit media. Cloudinary credentials stay on the server; required in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=buildflow
MEDIA_MAX_BYTES=10485760
UNIT_MEDIA_MAX_COUNT=30
DOCUMENT_MAX_BYTES=15728640
DOCUMENT_URL_TTL_SECONDS=300
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Bootstrap seed (npm run seed). Leave empty to skip creating the admin user. ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin
